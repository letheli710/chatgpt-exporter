          "content_type": "text",
          "parts": [
            "资源开始\n\n{@body const [showImage,setShowImage] = DIL.useState(false)}\n<box maxWidth=\"420px\">\n  <card gap={3}>\n    <checkbox checked={showImage} onChange={setShowImage} lineThrough={false}>显示公开测试图</checkbox>\n    {#if showImage}\n      <AppBlock title=\"公开测试图\" language=\"html\" variant=\"inline\" app_block_id=\"python-resource-test\">\n        <div id=\"resource-test\" style=\"font-family:inherit\">\n          <div id=\"resource-status\" role=\"status\" aria-live=\"polite\" style=\"font-size:13px;margin-bottom:10px\">加载中</div>\n          <div id=\"resource-image\"></div>\n        </div>\n        <script>\n          (() => {\n            const root = document.getElementById('resource-test');\n            const status = root.querySelector('#resource-status');\n            const image = document.createElement('img');\n            image.alt = 'Python 官方公开测试图';\n            image.referrerPolicy = 'no-referrer';\n            image.style.cssText = 'display:block;width:100%;height:auto;object-fit:contain';\n            image.addEventListener('load', () => { status.textContent = '已加载'; });\n            image.addEventListener('error', () => { status.textContent = '加载失败'; });\n            root.querySelector('#resource-image').appendChild(image);\n            image.src = 'https://www.python.org/static/community_logos/python-logo.png';\n          })();\n        </script>\n      </AppBlock>\n    {:else}\n      <text color=\"secondary\" size=\"sm\">图片未挂载</text>\n    {/if}\n  </card>\n</box>\n\n资源结束"
          ]
        },
