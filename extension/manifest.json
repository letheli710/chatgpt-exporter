{
  "manifest_version": 3,
  "name": "Fast Speed Exporter · 文字导出",
  "version": "0.5.0",
  "description": "直接读取 ChatGPT 会话正文，选择消息并快速导出 Markdown。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_title": "打开对话导出面板"
  },
  "background": {
    "service_worker": "background.js"
  }
}
