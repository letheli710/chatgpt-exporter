{
  "manifest_version": 3,
  "name": "Fast Speed Exporter · Swift Archive",
  "version": "0.7.0",
  "version_name": "0.7.0 Swift Archive (data-first)",
  "description": "从会话接口快速导出正文、原图与交互界面数据；截图可选。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_title": "打开对话导出面板"
  },
  "background": {
    "service_worker": "background.js"
  }
}
