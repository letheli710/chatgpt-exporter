{
  "manifest_version": 3,
  "name": "Fast Speed Exporter · Swift Archive",
  "version": "0.8.10",
  "version_name": "0.8.10 Swift Archive (card snapshot)",
  "description": "从会话接口快速导出正文、原图与交互界面数据；截图可选。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_title": "打开对话导出面板"
  },
  "background": {
    "service_worker": "background.js"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["sandbox.html"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
